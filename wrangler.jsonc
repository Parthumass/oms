{
  // Tells Cloudflare how to host the portal: serve the built "dist" folder,
  // and send every page address to the app so links like /students work.
  "name": "portal",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
